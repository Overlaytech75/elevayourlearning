# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must never be committed.

# --- Supabase (from `supabase start` when running locally) -------------------
# Browser-visible values. ONLY the URL and the publishable/anon key belong here.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="<local-anon-key-printed-by-supabase-start>"

# Same values, for server-side rendering and server functions.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="<local-anon-key-printed-by-supabase-start>"

# Server-only. NEVER prefix this with VITE_ and never use it in client code.
# Optional locally — the app works without it.
# SUPABASE_SERVICE_ROLE_KEY="<local-service-role-key>"

# --- Local feature flags -----------------------------------------------------
# Both default to enabled. Turn them off for local development.
VITE_AI_ENABLED="false"
VITE_GOOGLE_AUTH_ENABLED="false"

# --- Optional: bring your own AI provider ------------------------------------
# Leave unset to run without AI. If you set these, also set VITE_AI_ENABLED=true.
# AI_GATEWAY_URL="https://api.openai.com/v1"
# AI_API_KEY="<your-own-key>"
# AI_MODEL="gpt-4o-mini"
